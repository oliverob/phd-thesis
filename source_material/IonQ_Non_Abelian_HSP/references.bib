volume = {101},
number = {38},
pages = {385104},
author = {Kuo, Nan-Hong and Wong, Renata},
title = {A quantum Bluestein’s algorithm for arbitrary-size quantum Fourier transform},
journal = {Physica Scripta},
abstract = {We propose a quantum analogue of Bluestein’s algorithm (QBA) that implements an algebraically exact -point quantum Fourier transform (QFT) for arbitrary . Our construction factors the -dimensional QFT unitary  into three diagonal quadratic-phase gates and two standard radix-2 QFT subcircuits of size  (with ). This achieves asymptotic gate complexity of  and uses  qubits. We validate the correctness of the algorithm through a concrete implementation in Qiskit, confirming that QBA produces the exact -point discrete Fourier transform on arbitrary-length inputs. The proposed framework is especially relevant for biomedical time-series analysis and quantum-kernel methods, where irregular, non-power-of-two signal lengths are common and zero-padding may introduce distortions in the represented -point spectrum.}
}

